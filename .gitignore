# ---------------------------------------------------------------------------
# DexMimicGen project-specific
# ---------------------------------------------------------------------------

# Datasets: the top-level `datasets` is a symlink to a large external store, and
# `datasets_src` / `datasets_gen` hold multi-GB source and generated hdf5 demos.
/datasets
datasets_src/
datasets_gen/
*.hdf5
*.hdf5.lock

# Generated rollout / debug videos
*.mp4
*.gif

# IDE / tooling scratch dir
.sii/

# Reference material under references/ -- external checkouts and symlinks to repos
# that live outside this project, not part of the reproduction code.
references/

# Internal report / paper working directory (LaTeX sources, build intermediates,
# scratch notes) -- not part of the released reproduction code.
report/

# Python packaging metadata regenerated by `pip install -e .`
*.egg-info/